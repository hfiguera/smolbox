{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smolbox-node-authority-configuration-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "binding",
    "paths",
    "guard",
    "source_basis"
  ],
  "properties": {
    "version": {
      "const": 1,
      "type": "integer"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_anchor_uid",
        "cluster_id",
        "generation",
        "kind",
        "namespace",
        "namespace_uid",
        "node_boot_id",
        "node_name",
        "node_uid",
        "runtime_class",
        "runtime_class_uid",
        "runtime_identity",
        "runtime_policy_digest",
        "target_id",
        "version"
      ],
      "properties": {
        "cluster_anchor_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[ -~]+$"
        },
        "cluster_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[ -~]+$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "const": "kubernetes"
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[ -~]+$"
        },
        "namespace_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[ -~]+$"
        },
        "node_boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[ -~]+$"
        },
        "node_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[ -~]+$"
        },
        "node_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[ -~]+$"
        },
        "runtime_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[ -~]+$"
        },
        "runtime_class_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[ -~]+$"
        },
        "runtime_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "archive_sha256",
            "containerd_version",
            "guard_sha256",
            "guard_template_sha256",
            "k3s_version",
            "kernel_sha256",
            "libkrun_sha256",
            "rootfs_sha256",
            "shim_sha256",
            "smolvm_version"
          ],
          "properties": {
            "archive_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "containerd_version": {
              "const": "2.2.10-k3s1"
            },
            "guard_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "guard_template_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "k3s_version": {
              "const": "v1.35.10+k3s1"
            },
            "kernel_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "libkrun_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "rootfs_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "shim_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "smolvm_version": {
              "const": "1.34.0"
            }
          }
        },
        "runtime_policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[ -~]+$"
        },
        "version": {
          "const": 1,
          "type": "integer"
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_directory",
        "database",
        "vm_root",
        "share_root",
        "runtime_root",
        "runtime_archive",
        "kubeconfig",
        "cri_socket",
        "k3s_executable",
        "daemon_executable",
        "kubectl_executable",
        "systemctl_executable",
        "ip_executable",
        "nft_executable",
        "nsenter_executable",
        "proc_root",
        "cgroup_root",
        "netns_root",
        "guard_program",
        "guard_state"
      ],
      "properties": {
        "state_directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "database": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "vm_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "share_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "runtime_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "runtime_archive": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "kubeconfig": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "cri_socket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "k3s_executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "daemon_executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "kubectl_executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "systemctl_executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "ip_executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "nft_executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "nsenter_executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "proc_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "cgroup_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "netns_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "guard_program": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "guard_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_name",
        "marker",
        "namespace_manager",
        "bridge"
      ],
      "properties": {
        "table_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[ -~]+$"
        },
        "marker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[ -~]+$"
        },
        "namespace_manager": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[ -~]+$"
        },
        "bridge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[ -~]+$"
        }
      }
    },
    "source_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_sha256",
        "lifecycle_sha256"
      ],
      "properties": {
        "history_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lifecycle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
