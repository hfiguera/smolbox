      "description": "One bounded work area with a ruled header.",
      "html": "<section class=\"ds-workspace\"><header class=\"ds-workspace-header\"><h2>My workspace</h2></header><div class=\"ds-workspace-body\">Commands, files, and retained activity.</div></section>",
      "css": ".ds-workspace{font-family:'DM Sans Variable',sans-serif;background:var(--surface, #fffef9);color:var(--ink, #252820);border:1px solid var(--rule, #dcded2);border-radius:var(--radius,12px);overflow:hidden}.ds-workspace-header{padding:26px 30px 20px;border-bottom:1px solid var(--rule, #dcded2)}.ds-workspace h2{font-size:24px;font-weight:650;letter-spacing:-.025em;margin:0}.ds-workspace-body{padding:28px 30px;font-size:14px;line-height:1.6;color:var(--muted, #626657)}"
    },
    {
      "name": "Mapped Service Link",
      "kind": "custom",
      "refersTo": "service-link",
      "description": "A ruled external link, without an implied readiness indicator.",
      "html": "<a class=\"ds-service\" href=\"#service\">Open service<svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M4 16 16 4M5 4h11v11\"/></svg></a>",
      "css": ".ds-service{font-family:'DM Sans Variable',sans-serif;display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid #b8bea7;color:var(--ink, #252820);font-size:15px;font-weight:650;text-decoration:none}.ds-service svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.6;flex:none}.ds-service:hover{color:var(--focus, #496121)}.ds-service:focus-visible{outline:3px solid var(--focus, #496121);outline-offset:4px}"
