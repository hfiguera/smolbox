      "html": "<div class=\"ds-terminal\" tabindex=\"0\" aria-label=\"Terminal surface preview\"><span>Open a terminal to connect to your guest shell.</span></div>",
      "css": ".ds-terminal{height:320px;min-height:180px;padding:16px;border-radius:7px;overflow:auto;resize:vertical;background:#22261f;color:#eff1e6;font-family:\"JetBrains Mono Variable\",monospace;font-size:13px;line-height:1.5}.ds-terminal span{color:#bfc7af}.ds-terminal:focus-visible{outline:3px solid var(--focus, #496121);outline-offset:4px}"
    }
