
defmodule Consumer.Transport do
  @behaviour SmolBox.Transport
  @impl true
  def request(_worker, %{method: :get, path: "/health"}) do
    send(self(), :fake_transport_called)
    {:ok, ~s({"status":"ok","version":"1.16.1","machines":{"total":0,"running":0}})}
  end
end

defmodule Consumer.Artifacts do
  @behaviour SmolBox.ArtifactStore
  @impl true
  def read(_, _, _, _), do: raise("unexpected artifact access")
  @impl true
  def put(_, _, _, _, _), do: raise("unexpected artifact access")
end

{:ok, _apps} = Application.ensure_all_started(:smolbox)
[] = Application.spec(:smolbox, :mod)
{:ok, endpoint} = SmolBox.Worker.new("consumer", "http://127.0.0.1:1", allow_insecure_loopback: true)
{:ok, client} = SmolBox.Client.new(endpoint, transport: Consumer.Transport)
{:ok, %{version: "1.16.1", total: 0, running: 0}} = SmolBox.Client.health(client)
receive do
  :fake_transport_called -> :ok
after
  100 -> raise "client did not exercise the supplied transport"
end

{:ok, profile} = SmolBox.Profile.new("consumer")
:offline = profile.network
{:ok, network} = SmolBox.NetworkPolicy.new(hosts: ["api.example.com"])
{:ok, network_profile} = SmolBox.Profile.new("consumer-network", network: network)
{:ok, network_machine} = SmolBox.Profile.machine(network_profile, "consumer-net", "/approved/python.smolmachine")
{:ok, %{"network" => true, "networkBackend" => "virtio-net", "allowedHosts" => ["api.example.com"], "allowedCidrs" => []}} = SmolBox.MachineSpec.to_wire(network_machine)
worker_options = [client: client, platform: :linux, architecture: "x86_64",
  profiles: [profile], allocation_floor: %{storage_gb: 1, overlay_gb: 1, host_overhead_mb: 256},
  capacity: %{slots: 1, cpus: 1, memory_mb: 1024, disk_gb: 2},
  artifacts: [%{"id" => "python", "sha256" => String.duplicate("a", 64),
    "architecture" => "x86_64", "path" => "/approved/python.smolmachine"}]]
{:ok, %{runtime_version: "1.16.1"}} = SmolBox.Runtime.WorkerConfig.new(worker_options)
{:ok, %{runtime_version: "1.14.1"}} = SmolBox.Runtime.WorkerConfig.new(
  Keyword.put(worker_options, :runtime_version, "1.14.1"))
{:ok, %{runtime_version: "1.14.6"}} = SmolBox.Runtime.WorkerConfig.new(
  Keyword.put(worker_options, :runtime_version, "1.14.6"))

{:ok, %{runtime_version: "1.16.0"}} = SmolBox.Runtime.WorkerConfig.new(
  Keyword.put(worker_options, :runtime_version, "1.16.0"))

{:error, %SmolBox.Error{category: :validation}} = SmolBox.Runtime.WorkerConfig.new(
  Keyword.put(worker_options, :runtime_version, "1.16.2"))

{:ok, checkpoint} = SmolBox.Checkpoint.new(id: "idle", sha256: String.duplicate("b", 64),
  architecture: "x86_64", platform: :linux, path: "/approved/idle.smolcheckpoint", profile: profile)
{:ok, checkpoint_worker} = SmolBox.Runtime.WorkerConfig.new(
  Keyword.merge(worker_options, artifacts: [], checkpoints: [checkpoint]))
{:ok, checkpoint_command} = SmolBox.Command.new(["true"])
{:ok, checkpoint_spec} = SmolBox.ExecutionSpec.new(scope: "consumer", id: "idle",
  artifact: SmolBox.Checkpoint.artifact(checkpoint), command: checkpoint_command, profile: profile)
true = SmolBox.Runtime.WorkerConfig.supports?(checkpoint_worker, checkpoint_spec)
{:ok, checkpoint_fingerprint} = SmolBox.ExecutionSpec.fingerprint(checkpoint_spec, :binary.copy(<<1>>, 32))
{:ok, checkpoint_record} = SmolBox.Execution.new(checkpoint_spec, checkpoint_fingerprint, 1000)
{:ok, <<"smolbox-record-v3", 0, _::binary>> = checkpoint_bytes} = SmolBox.Store.Codec.encode(checkpoint_record)
{:ok, ^checkpoint_record} = SmolBox.Store.Codec.decode(checkpoint_bytes)

children = [
  {SmolBox.Store.Memory, name: Consumer.Store},
  {SmolBox, name: Consumer.Runtime, namespace: "consumer", mode: :ephemeral,
    store: {SmolBox.Store.Memory, Consumer.Store},
    artifact_store: {Consumer.Artifacts, nil},
    fingerprint_key: :crypto.strong_rand_bytes(32), workers: []}
]
{:ok, supervisor} = Supervisor.start_link(children, strategy: :one_for_one)
{:ok, []} = SmolBox.workers(Consumer.Runtime)
{:error, %{category: :not_found}} = SmolBox.fetch(Consumer.Runtime, "scope", "missing")
{:error, %{category: :not_found}} = SmolBox.cancel(Consumer.Runtime, "scope", "missing")
:ok = Supervisor.stop(supervisor)
nil = Process.whereis(Consumer.Runtime)
versions = Map.new([:req, :jason, :telemetry, :nimble_options], fn app ->
  {app, app |> Application.spec(:vsn) |> to_string()}
end)
File.write!("smoke.json", Jason.encode!(%{client: true, supervisor: true,
  checkpoint: true, network_policy: true, offline_default: true, runtime_1_16_0_explicit: "1.16.0",
  unqualified_runtime_rejected: "1.16.2", runtime_default: "1.16.1", legacy_runtime_explicit: "1.14.1",
  legacy_1_14_6_explicit: "1.14.6", versions: versions}))
